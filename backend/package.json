{
  "name": "reconnect-backend",
  "version": "1.0.0",
  "description": "ReConnect Community Sharing Platform API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node -e \"import('./src/config/db.js').then(m => m.initDb()).then(() => import('./src/db/migrate.js')).then(m => m.runMigrations()).then(() => process.exit(0))\"",
    "seed": "node -e \"import('./src/config/db.js').then(m => m.initDb()).then(() => import('./src/db/seed.js')).then(m => m.seedDatabase()).then(() => process.exit(0))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  }
}

